---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Fabrikkutsalg av gravemaskiner og grunnarbeidsutstyr i Varhaug. Leveringsklare maskiner med rimelig og rask levering i hele Norge." } = Astro.props;
const base = import.meta.env.BASE_URL;
// Strip base path from pathname to get canonical path relative to site root
const pathWithoutBase = Astro.url.pathname.startsWith(base)
  ? Astro.url.pathname.slice(base.length) || '/'
  : Astro.url.pathname;
const canonicalURL = new URL(pathWithoutBase, Astro.site);
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="nb_NO" />
    <meta property="og:site_name" content="Vigrestad Maskin" />

    <!-- Open Graph Image -->
    <meta property="og:image" content="https://vigrestadmaskin.no/images/hero-r10-landscape.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Gravemaskiner og anleggsutstyr - Vigrestad Maskin fabrikkutsalg" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://vigrestadmaskin.no/images/hero-r10-landscape.jpg" />
    <meta name="twitter:image:alt" content="Gravemaskiner og anleggsutstyr - Vigrestad Maskin fabrikkutsalg" />

    <!-- SEO Controls -->
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#78716c" />

    <!-- Local Business / Store Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["Store", "LocalBusiness"],
      "@id": "https://vigrestadmaskin.no",
      "name": "Vigrestad Maskin",
      "description": "Fabrikkutsalg av gravemaskiner og grunnarbeidsutstyr. Kompaktlastere, minigraver og anleggsmaskiner til salgs.",
      "url": "https://vigrestadmaskin.no",
      "telephone": "+4798877800",
      "email": "ege68@msn.com",
      "image": "https://vigrestadmaskin.no/images/hero-r10-landscape.jpg",
      "logo": "https://vigrestadmaskin.no/images/logo-brand.jpg",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Ånestadvegen 23",
        "addressLocality": "Varhaug",
        "addressRegion": "Rogaland",
        "postalCode": "4365",
        "addressCountry": "NO"
      },
      "areaServed": [
        {
          "@type": "Country",
          "name": "Norge"
        },
        {
          "@type": "AdministrativeArea",
          "name": "Rogaland"
        }
      ],
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 58.6025,
        "longitude": 5.6503
      },
      "priceRange": "$$",
      "currenciesAccepted": "NOK",
      "paymentAccepted": "Kontant, Bankoverføring",
      "openingHours": "Mo-Fr 08:00-16:00",
      "sameAs": [
        "https://www.facebook.com/p/Vigrestad-Maskin-61573569952484/",
        "https://youtube.com/@vigrestadmaskin"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Gravemaskiner og anleggsutstyr",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Product",
              "name": "Gravemaskiner",
              "description": "Kompakte gravemaskiner og minigraver for anlegg og gårdsdrift"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Product",
              "name": "Kompaktlastere",
              "description": "Kompaktlastere for effektiv håndtering av masser"
            }
          }
        ]
      }
    })} />

    <!-- Product Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Product",
      "name": "Gravemaskiner og anleggsmaskiner",
      "description": "Bredt utvalg av gravemaskiner, minigraver og kompaktlastere for salg. Leveringsklare maskiner med rask levering i hele Norge.",
      "category": "Bygge- og anleggsmaskiner",
      "image": "https://vigrestadmaskin.no/images/product-r15-closeup.jpg",
      "brand": {
        "@type": "Organization",
        "name": "Vigrestad Maskin",
        "url": "https://vigrestadmaskin.no"
      },
      "offers": {
        "@type": "AggregateOffer",
        "availability": "https://schema.org/InStock",
        "priceCurrency": "NOK",
        "offerCount": "10",
        "seller": {
