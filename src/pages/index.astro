---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout
  title="Gravemaskiner til salgs | Vigrestad Maskin"
  description="Fabrikkutsalg av gravemaskiner og grunnarbeidsutstyr i Varhaug. Leveringsklare maskiner med rimelig og rask levering i hele Norge. Ring 988 77 800."
>
  <main>
    <!-- Hero Image Section with Floating Logo -->
    <section class="image-section hero">
      <h1 class="sr-only">Vigrestad Maskin – Fabrikkutsalg av gravemaskiner og grunnarbeidsutstyr</h1>
      <div class="relative h-[60vh] md:h-[80vh] overflow-hidden rounded-sm">
        <img
          src={`${base}/images/hero-r10-landscape.jpg`}
          alt="R10 ECO minigraver i norsk landskap - Vigrestad Maskin"
          class="w-full h-full object-cover"
        />
        <!-- Centered Logo at bottom - jutul.no style -->
        <div class="logo-container">
          <img
            src={`${base}/images/logo-brand.jpg`}
            alt="Vigrestad Maskin"
            class="logo"
          />
        </div>

      </div>
    </section>

    <!-- Sticky mobile phone bar - tap to call, hidden on desktop -->
    <div class="mobile-call-bar md:hidden" aria-label="Ring oss">
      <span class="mobile-call-bar__label">Leverandør til hele Norge</span>
      <a href="tel:+4798877800" class="mobile-call-bar__link">
        <svg class="mobile-call-bar__icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 6.75z" />
        </svg>
        988 77 800
      </a>
    </div>

    <!-- Introduction Text Section -->
    <section class="text-section">
      <h2>Fabrikkutsalg av gravemaskiner</h2>
      <p>
        Vigrestad Maskin tilbyr et bredt utvalg av gravemaskiner og utstyr.
        Vi har flere leveringsklare maskiner og kan tilby rimelig og rask levering i hele Norge.
      </p>
      <a href="tel:+4798877800" class="hero-cta__phone">Ring oss på 988 77 800</a>
      <p class="hero-cta__tagline">Maskiner på lager — klare for levering</p>
    </section>

    <!-- Product Specs Section -->
    <section class="product-specs-section">

      <h2 class="product-specs-section__heading">Våre maskiner</h2>

      <div class="product-specs-section__inner">

        <!-- Product 1: Minigraver -->
        <article class="product-card">
          <p class="product-card__category">Minigraver</p>
          <h3 class="product-card__name">R-serien ECO</h3>
          <p class="product-card__lead">
            Kompakt og kraftig — ideell for trange arbeidsforhold, hager og gårdsdrift.
          </p>

          <dl class="product-card__specs">
            <div class="product-card__spec-item">
              <dt>Vekt</dt>
              <dd>1 850 kg</dd>
            </div>
            <div class="product-card__spec-item">
              <dt>Gravdybde</dt>
              <dd>2 100 mm</dd>
            </div>
            <div class="product-card__spec-item">
              <dt>Motoreffekt</dt>
              <dd>13,5 kW</dd>
            </div>
            <div class="product-card__spec-item">
              <dt>Skuffe</dt>
              <dd>0–500 mm</dd>
            </div>
          </dl>

          <ul class="product-card__points" role="list">
            <li>Leveringsklart fra lager</li>
            <li>Egnet for trange og krevende terreng</li>
            <li>Fabrikkpris — ingen importmellomledd</li>
          </ul>
        </article>

        <!-- Product 2: Kompaktlaster -->
        <article class="product-card">
          <p class="product-card__category">Kompaktlaster</p>
          <h3 class="product-card__name">WL-serien</h3>
          <p class="product-card__lead">
            Allsidig hjullaster for massehåndtering, paller og redskapsbytte på sekunder.
          </p>

          <dl class="product-card__specs">
            <div class="product-card__spec-item">
              <dt>Vekt</dt>
              <dd>2 400 kg</dd>
            </div>
            <div class="product-card__spec-item">
              <dt>Løftekapasitet</dt>
              <dd>800 kg</dd>
            </div>
            <div class="product-card__spec-item">
              <dt>Motoreffekt</dt>
              <dd>25,5 kW</dd>
            </div>
            <div class="product-card__spec-item">
              <dt>Redskapsfeste</dt>
              <dd>Hurtigfeste</dd>
            </div>
          </dl>

          <ul class="product-card__points" role="list">
            <li>Rask redskapsskift — ingen verktøy nødvendig</li>
            <li>Kompakt byggelengde, god sikt fra førerrom</li>
            <li>Tilgjengelig med vinter- og bonuspakker</li>
          </ul>
        </article>

      </div>

      <p class="product-specs-section__cta-note">
        Ta kontakt for priser og tilgjengelighet —
        <a href="tel:+4798877800" class="product-specs-section__cta-link">988 77 800</a>
      </p>

    </section>

    <!-- Equipment Image Section with Floating Text -->
    <section class="image-section">
      <div class="relative h-auto md:h-[85vh]">
        <div class="absolute inset-0 overflow-hidden rounded-sm">
          <img
            src={`${base}/images/product-r15-closeup.jpg`}
            alt="R15 ECO gravemaskin - kompakt og kraftig"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <!-- Floating Text Box - Right Side (outside overflow-hidden) -->
        <div class="floating-text-box right middle">
          <h3>Gravemaskiner og kompaktlastere</h3>
          <p>
            Vi fører kompakte gravemaskiner (minigraver) og kompaktlastere — anleggsmaskiner ideelt for grunnarbeid, anlegg og gårdsdrift. Maskinene leveres klargjort med standard skuffe, hydrauliske hurtigkoblinger og variert tilbehør.
          </p>
          <ul>
            <li>Driftsvekt: fra ca. 1 200 kg (minigraver) til ca. 3 500 kg (kompaktgraver)</li>
            <li>Gravdybde: opp til ca. 2 100 mm</li>
            <li>Tippehøyde: opp til ca. 2 600 mm</li>
            <li>Motor: dieseldrevet</li>
            <li>Hydraulisk tilkobling: hurtigkoblinger for tilleggsutstyr</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Delivery Image Section with Floating Text -->
    <section class="image-section">
      <div class="relative h-auto md:h-[85vh]">
        <div class="absolute inset-0 overflow-hidden rounded-sm">
          <img
            src={`${base}/images/inventory-tractors.jpg`}
            alt="Stort utvalg av gravemaskiner og traktorer på lager"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <!-- Floating Text Box - Left Side (outside overflow-hidden) -->
        <div class="floating-text-box left middle">
          <h3>Leveringsklare maskiner</h3>
          <p>
            Vigrestad Maskin er et fabrikkutsalg med gravemaskiner og anleggsmaskiner direkte på lager. Vi leverer over hele Norge — raskt og til konkurransedyktige priser. Kontakt oss for å høre hva som er tilgjengelig akkurat nå.
          </p>
          <ul>
            <li>Leveringsklare maskiner på lager</li>
            <li>Fabrikkutsalgspriser — ingen fordyrende mellomledd</li>
            <li>Levering i hele Norge</li>
            <li>Rask respons — ring 988 77 800</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- YouTube Video Section -->
    <section class="video-section">
      <div class="max-w-4xl mx-auto">
        <h2 class="video-section__heading">Se maskinene i aksjon</h2>
        <p class="video-section__body">
          Vi deler jevnlig videoer av maskinene våre på YouTube.
        </p>
        <div class="video-section__embed-wrapper">
          <div class="aspect-video rounded-sm overflow-hidden shadow-xl bg-earth-200">
            <iframe
              src="https://www.youtube-nocookie.com/embed/Rfd9vKpNfU4"
              title="De forskjellige gravemaskin modellene med priser – Vigrestad Maskin"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              loading="lazy"
              class="w-full h-full"
            ></iframe>
          </div>
        </div>
        <p class="mt-6 text-center">
          <a
            href="https://youtube.com/@vigrestadmaskin"
            target="_blank"
            rel="noopener noreferrer"
            class="video-section__channel-link"
          >
            Se alle videoer på YouTube →
          </a>
        </p>
      </div>
    </section>

    <!-- Final Image Section with Floating Text -->
    <section class="image-section">
      <div class="relative h-auto md:h-[85vh]">
        <div class="absolute inset-0 overflow-hidden rounded-sm">
          <img
            src={`${base}/images/detail-comfort-seat.jpg`}
            alt="Ergonomisk førersete og kontroller i Rippa gravemaskin"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <!-- Floating Text Box - Right Side (outside overflow-hidden) -->
        <div class="floating-text-box right middle">
          <h3>Om Vigrestad Maskin</h3>
          <p>
            En lokal bedrift med fokus på kvalitet og service siden 2024.
          </p>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="py-24 md:py-32 px-6 bg-earth-100">
    <div class="footer-contact max-w-3xl mx-auto text-center">
      <h2>Kontakt oss</h2>

      <address class="not-italic space-y-4">
        <p class="font-medium text-earth-800">Vigrestad Maskin</p>
        <p>Ånestadvegen 23</p>
        <p>4365 Varhaug</p>

        <div class="contact-details pt-6 space-y-2">
          <p>
            <a href="tel:+4798877800" class="hover:text-machinery-700 transition-colors font-medium">
              988 77 800
            </a>
          </p>
          <p>
            <a href="mailto:ege68@msn.com" class="hover:text-machinery-700 transition-colors">
              ege68@msn.com
            </a>
          </p>
        </div>

        <!-- Social Media Icons -->
        <div class="flex items-center justify-center gap-6 pt-6">
          <a
            href="https://www.facebook.com/p/Vigrestad-Maskin-61573569952484/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Følg oss på Facebook"
            class="text-earth-600 hover:text-machinery-600 transition-colors"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd" />
            </svg>
          </a>
          <a
            href="https://youtube.com/@vigrestadmaskin"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Se videoer på YouTube"
            class="text-earth-600 hover:text-machinery-600 transition-colors"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M19.812 5.418c.861.23 1.538.907 1.768 1.768C21.998 8.746 22 12 22 12s0 3.255-.418 4.814a2.504 2.504 0 0 1-1.768 1.768c-1.56.419-7.814.419-7.814.419s-6.255 0-7.814-.419a2.505 2.505 0 0 1-1.768-1.768C2 15.255 2 12 2 12s0-3.255.417-4.814a2.507 2.507 0 0 1 1.768-1.768C5.744 5 11.998 5 11.998 5s6.255 0 7.814.418ZM15.194 12 10 15V9l5.194 3Z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </address>

      <p class="copyright">
        © 2025 Vigrestad Maskin | Laget av eik-it
      </p>
    </div>
  </footer>
</Layout>
